<%layout("/layouts/boilerplate") %>
<body>
    <div class="row new-container">
        <div class="col-7 offset-2">
            <br>
            <h3>Create a New Listing</h3>
            <form action="/listings" method="POST" novalidate class="needs-validation" enctype="multipart/form-data">
                <div class="mb-3">
                    <label for="title" class="form-label"><i class="fas fa-crown"></i> Title</label>
                    <input type="text" name="listing[title]" placeholder="enter title" class="form-control" required>
                    <div class="valid-feedback">Looks Good!</div>
                    <div class="invalid-feedback">Please enter a valid title</div>
                </div>
                
                <div class="mb-3">
                    <label for="description" class="form-label"><i class="fas fa-align-left"></i> Description</label>
                    <textarea name="listing[description]" placeholder="enter description" class="form-control" required></textarea>
                    <div class="valid-feedback">Looks Good!</div>
                    <div class="invalid-feedback">Please enter a short description</div>
                </div>
                <!-- <div class="mb-3">
                    <label for="image" class="form-label">Image-Link</label>
                    <input type="text" name="listing[image][url]" placeholder="enter image URL/link" class="form-control">
                </div> -->
                <div class="mb-3">
                    <label for="image" class="form-label"><i class="fas fa-image"></i> Upload Listing image</label>
                    <input type="file" name="listing[image]" placeholder="enter image URL/link" class="form-control" required>
                </div>
                <div class="row">
                    <div class="mb-3 col-md-4">
                        <label for="price" class="form=label"><i class="fa-solid fa-tag"></i> Price</label>
                        <input type="text" name="listing[price]" placeholder="enter price" class="form-control" required>
                        <div class="valid-feedback">Looks Good!</div>
                        <div class="invalid-feedback">Please enter a valid price</div>
                    </div>
                    <div class="mb-3 col-md-8">
                        <label for="location" class="form-label"><i class="fa-solid fa-location-dot"></i> Venue</label>
                        <input type="text" name="listing[location]" placeholder="enter location" class="form-control" required>
                        <div class="valid-feedback">Looks Good!</div>
                        <div class="invalid-feedback">Please enter a valid location</div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-4 mb-3">
                    <label for="country" class="form-label"><i class="fa-solid fa-globe"></i> Country</label>
                    <input type="text" name="listing[country]" placeholder="enter country" class="form-control" required>
                    <div class="invalid-feedback">Please enter a valid country name</div>
                </div>
                <div class="mb-3 col-md-8">
                    <label for="country" class="form-label"><i class="fa-solid fa-list"></i> Choice Category</label>
                    <select name="listing[category]" class="form-select new-Listing-Category">
                        <option value="">All Categories</option>
                        <option value="Trending">Trending</option>
                        <option value="Room">Room</option>
                        <option value="Iconic Cities">Iconic Cities</option>
                        <option value="Mountains">Mountains</option>
                        <option value="Castles">Castles</option>
                        <option value="Amazing Pools">Amazing Pools</option>
                        <option value="Camping">Camping</option>
                        <option value="Farms">Farms</option>
                        <option value="Arctic">Arctic</option>
                        <option value="Domes">Domes</option>
                        <option value="Boats">Boats</option>
                    </select>
                </div>
                </div>
                
                <button class="btn btn-new">Add</button>
                <br><br>
            </form>
        </div>
    </div>
    
</body>
